[

    {
        "group": "Effects:",
        "selector": ".SocialBarBody",
        "type": "checkbox",
        "id": "backGradient",
        "label": "Enable Gradient",
        "property": "background-image",
        "enabled": "linear-gradient(23deg, #000000cf 5%, #910404fc 155%)",
        "disabled": "none",
        "default": true
    },

    {
        "group": "Effects:",
        "selector": ".SocialBarBody",
        "type": "checkbox",
        "id": "backShadow",
        "label": "Enable Inner Shadow",
        "property": "box-shadow",
        "enabled": "0 0 25px #00000085, inset 0 0 16px #000000",
        "disabled": "none",
        "default": false
    },

    {
        "group": "Colors:",
        "selector": ".SocialBarBody",
        "type": "color",
        "label": "Background Color",
        "property": "background-color"
    },

    {
        "group": "Colors:",
        "selector": ".SocialBarBody",
        "type": "color-opacity",
        "label": "Opacity",
        "property": "background-color" 
    },
    
    {
        "group": "Colors:",
        "selector": ".SocialBarBody",
        "type": "gradientColor",
        "toggle": "backGradient",
        "label": "Gradient 1",
        "property": "background-image",
        "index": 0
    },

    {
        "group": "Colors:",
        "selector": ".SocialBarBody",
        "type": "gradient-opacity",
        "label": "Opacity",
        "property": "background-image",
        "index": 0
    },

    {
        "group": "Colors:",
        "selector": ".SocialBarBody",
        "type": "gradientColor",
        "toggle": "backGradient",
        "label": "Gradient 2",
        "property": "background-image",
        "index": 1
    },

    {
        "group": "Colors:",
        "selector": ".SocialBarBody",
        "type": "gradient-opacity",
        "label": "Opacity",
        "property": "background-image",
        "index": 1
    },

    {
        "group": "Colors:",
        "selector": ".SocialBarBody",
        "type": "color",
        "label": "Border Color",
        "property": "border-color"
    },

    {
        "group": "Colors:",
        "selector": ".SocialBarBody",
        "type": "color-opacity",
        "label": "Opacity",
        "property": "border-color"
    },

    {
        "group": "Colors:",
        "selector": ".SocialBarBody",
        "type": "slider",
        "label": "Border Radius",
        "property": "border-radius",
        "unit": "rem",
        "min": 0.0,
        "max": 2.0,
        "step": 0.1
    }

]
