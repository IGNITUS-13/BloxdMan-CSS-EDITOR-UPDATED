    "step": 1
  },

  {
    "group": "Layout:",
    "selector": ".Title",
    "type": "slider",
    "label": "Width",
    "property": "width",
    "unit": "rem",
    "min": 0,
    "max": 30,
    "step": 1
  },

  {
    "group": "Layout:",
    "selector": ".Title",
    "type": "slider",
    "label": "Height",
    "property": "line-height",
    "unit": "rem",
    "min": 0,
    "max": 7,
    "step": 1
  },

  {
    "group": "Effects:",
    "selector": ".TitleContainer",
    "type": "slider",
    "label": "Opacity",
    "property": "opacity",
    "unit": "",
